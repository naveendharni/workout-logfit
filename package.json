{
  "name": "logfit",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait && npm run db:migrate && npm run db:seed && concurrently -n api,web -c green,cyan \"npm run dev -w api\" \"npm run dev -w web\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:reset": "npm run db:reset -w api",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
