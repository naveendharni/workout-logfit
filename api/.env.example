# Copy to api/.env. The user, password, port and db name must match the root .env.
DATABASE_URL=postgresql://logfit:change-me@localhost:5433/logfit
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Secret for signing access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Number of proxies in front of the API (0 locally, 1 behind a host like Vercel). Used to read the real client IP for rate limiting.
TRUST_PROXY=0
